# Backend-only. Never put real values in public/, Git, screenshots or chat.
PLATFORM_MODE=staging
PLATFORM_RELEASE_APPROVED=staging
PLATFORM_ORIGIN=https://YOUR-NEW-STAGING-HOST
# Exact immediate proxy IPs only, empty when directly exposed through local TLS.
PLATFORM_TRUSTED_PROXY_IPS=
PLATFORM_DATABASE_URL=postgresql://NEW_SERVER_ROLE:PASSWORD@NEW_SUPABASE_HOST:5432/postgres
PLATFORM_SUPABASE_URL=https://NEW_PROJECT.supabase.co
PLATFORM_SUPABASE_PUBLISHABLE_KEY=NEW_PUBLISHABLE_KEY
PLATFORM_SESSION_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
PLATFORM_R2_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
PLATFORM_R2_ENDPOINT=https://YOUR_ACCOUNT.r2.cloudflarestorage.com
PLATFORM_R2_ACCESS_KEY_ID=NEW_BUCKET_SCOPED_KEY
PLATFORM_R2_SECRET_ACCESS_KEY=NEW_BUCKET_SCOPED_SECRET
# Optional test integrations; never use live billing keys in this version.
PLATFORM_STRIPE_SECRET=sk_test_REPLACE
PLATFORM_STRIPE_WEBHOOK_SECRET=whsec_REPLACE
PLATFORM_STRIPE_PRICE_SINGLE=price_REPLACE
PLATFORM_STRIPE_PRICE_GATHERING=price_REPLACE
PLATFORM_STRIPE_PRICE_STUDIO=price_REPLACE
PLATFORM_EMAIL_KEY=REPLACE
PLATFORM_EMAIL_FROM=Lumiq <noreply@YOUR_VERIFIED_DOMAIN>
PLATFORM_SUPPORT_EMAIL=support@YOUR_DOMAIN
# HTTPS endpoint for production incident notifications (optional in staging).
PLATFORM_ALERT_WEBHOOK=
