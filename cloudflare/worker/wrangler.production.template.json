{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lumiq-production-candidate",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PLATFORM_MODE": "production",
    "PLATFORM_RELEASE_APPROVED": "NOT_APPROVED",
    "PLATFORM_SERVICE_NAME": "lumiq-production-candidate",
    "PLATFORM_ORIGIN": "https://lumiq-production-candidate.REPLACE_WITH_WORKERS_SUBDOMAIN.workers.dev",
    "PLATFORM_SUPABASE_URL": "https://replacewithprodprojectref.supabase.co",
    "PLATFORM_SUPABASE_PROJECT_REF": "replacewithprodprojectref",
    "PLATFORM_SUPABASE_PUBLISHABLE_KEY": "REPLACE_WITH_PRODUCTION_PUBLISHABLE_KEY",
    "PLATFORM_EMAIL_FROM": "Lumiq <noreply@lumiq.cam>",
    "PLATFORM_EMAIL_REPLY_TO": "support@lumiq.cam",
    "R2_BUDGET_ENABLED": "true",
    "R2_MAX_CLASS_A_OPS_MONTH": "1",
    "R2_MAX_CLASS_B_OPS_MONTH": "1",
    "R2_MAX_LIFETIME_WRITE_BYTES": "1",
    "R2_MAX_STREAM_WRITE_BYTES": "1",
    "LUMIQ_JOBS_DLQ_NAME": "lumiq-production-jobs-dlq"
  },
  "assets": {
    "directory": "../../platform/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/healthz", "/api/*"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_PHOTOS",
      "bucket_name": "lumiq-production-replace",
      "jurisdiction": "eu"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "LUMIQ_JOBS_QUEUE",
        "queue": "lumiq-production-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "lumiq-production-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "lumiq-production-jobs-dlq",
        "max_concurrency": 1
      },
      {
        "queue": "lumiq-production-jobs-dlq",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "max_concurrency": 1
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
