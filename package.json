{
  "name": "gala-produkts-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Photo-only event gallery SaaS platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node platform/server/start.mjs",
    "start": "node platform/server/staging.mjs",
    "worker": "node platform/server/staging.mjs --worker",
    "test": "node --test --test-concurrency=1 platform/tests/*.test.mjs",
    "test:ui": "node platform/tests/browser.cjs",
    "build": "node platform/scripts/build.mjs",
    "migrate": "node platform/scripts/migrate.mjs",
    "verify": "npm test && npm run build",
    "browser": "node platform/scripts/verify-browser.mjs",
    "security": "node platform/scripts/security-scan.mjs && npm audit --audit-level=high",
    "backup": "node platform/scripts/backup-cloud.mjs",
    "backup:verify": "node platform/scripts/verify-backup.mjs",
    "backup:production": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File platform/scripts/backup-production.ps1",
    "restore:drill": "node platform/scripts/restore-drill.mjs",
    "cost": "node platform/scripts/cost-model.mjs",
    "cloudflare:dev": "node platform/scripts/block-deploy.mjs --dev",
    "cloudflare:deploy": "node platform/scripts/block-deploy.mjs",
    "production:preflight": "node platform/scripts/production-preflight.mjs",
    "production:candidate:deploy": "node platform/scripts/deploy-production-candidate.mjs",
    "check": "npm run security && npm run verify && npm run browser"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/lib-storage": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@electric-sql/pglite": "0.5.8",
    "fabric": "7.4.0",
    "fflate": "0.8.3",
    "libphonenumber-js": "1.13.13",
    "lucide": "0.468.0",
    "luxon": "3.7.2",
    "postgres": "3.4.7",
    "qrcode": "1.5.4",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "acorn": "8.18.0",
    "esbuild": "0.28.1",
    "playwright": "1.63.0",
    "wrangler": "4.136.3"
  },
  "overrides": {
    "undici": "7.29.1"
  }
}
